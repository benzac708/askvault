# AskVault configuration.
#
# Copy to `.env` and edit. `.env` is gitignored; this template is tracked
# deliberately, so the full setting surface is reviewable without ever
# containing a credential.
#
#   cp .env.example .env
#
# The defaults below run the app with NO API key at all: the `mock` provider
# answers deterministically, and the full test suite passes against it. You only
# need a real provider to talk to a real model.

# --- application -----------------------------------------------------------
APP_NAME=askvault
LOG_LEVEL=INFO

# --- LLM provider ----------------------------------------------------------
# `mock`        deterministic canned answers. No network, no key. Default.
# `openrouter`  any OpenAI-compatible endpoint. Requires API key + base URL.
#
# Provider, model and base URL are CONFIGURATION and belong here (or in a
# ConfigMap in Kubernetes). The API key is a CREDENTIAL and belongs in a
# Secret. Do not collapse the two.
LLM_PROVIDER=mock

# For `mock` this is ignored. For a real provider, pin an EXACT model id --
# never a floating free tier, because a rotating pool whose behaviour changes
# without notice is indistinguishable from an outage.
LLM_MODEL=mock

# Required when LLM_PROVIDER is not `mock`. Example:
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=google/gemini-2.5-flash-lite
#   LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=

# SECRET. Leave empty here; supply via the environment or a Kubernetes Secret.
# Never commit a value to this file.
LLM_API_KEY=

LLM_TIMEOUT_SECONDS=30.0

# --- retrieval -------------------------------------------------------------
# Directory of markdown documents to index. Lexical retrieval (SQLite FTS5),
# so the corpus is the whole relevance model.
SAMPLES_DIR=samples

# SQLite index location. In the container this is an emptyDir at /data, the
# only writable path -- the root filesystem is read-only.
DB_PATH=data/askvault.db

# --- rate limits -----------------------------------------------------------
# Set BELOW the upstream provider's ceilings so the app refuses before the
# provider does. Plus plan this is 10 req/min per IP, 15 req/min global, and
# 40 req/day global, which at the pinned model's pricing is under two US cents
# a day if fully consumed.
#
# NOTE: the limiter is IN-PROCESS. Scaling beyond one replica multiplies the
# global ceilings by the replica count. Moving the counter to Redis is the
# correct fix and is deliberately not done at one replica.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=15
RATE_LIMIT_GLOBAL_PER_DAY=40

# Trust X-Forwarded-For. Correct BEHIND a reverse proxy that sets it (this
# deployment sits behind Cloudflare -> Caddy -> Traefik). If you ever expose
# the app directly, set this to false or clients can spoof their own IP and
# walk around the per-IP ceiling.
TRUST_FORWARDED_FOR=true

# --- observability ---------------------------------------------------------
METRICS_ENABLED=true
